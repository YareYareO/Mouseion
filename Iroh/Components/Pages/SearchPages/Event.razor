@page "/Event/search"
@inject NavigationManager NavigationManager
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<PageTitle>Search Events</PageTitle>

<h3>Search for Events!</h3>

<button class="btn btn-primary create-btn" @onclick="@(() => CreateGame())">Create New</button>
<Iroh.Components.Shared.Search currentSubject=@Page />

@code {
    Subject Page = Subject.Event;
    private void CreateGame()
    {
        NavigationManager.NavigateTo($"/{Page.ToString()}/create");
    }
}