@page "/Music/search"
@inject NavigationManager NavigationManager
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<PageTitle>Search Music</PageTitle>

<h3>Search for Music!</h3>

<button class="btn btn-primary create-btn" @onclick="@(() => CreateGame())">Create New</button>
<Iroh.Components.Shared.Search currentSubject=@Page />

@code {
    Subject Page = Subject.Music;
    private void CreateGame()
    {
        NavigationManager.NavigateTo($"/{Page.ToString()}/create");
    }
}
