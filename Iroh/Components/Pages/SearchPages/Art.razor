@page "/Art/search"
@inject NavigationManager NavigationManager
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<PageTitle>Search Fine Art</PageTitle>

<h3>Search for Fine Art!</h3>

<button class="btn btn-primary create-btn" @onclick="@(() => CreateGame())">Create New</button>
<Iroh.Components.Shared.Search currentSubject=@Page />

@code {
    Subject Page = Subject.Art;
    private void CreateGame()
    {
        NavigationManager.NavigateTo($"/{Page.ToString()}/create");
    }
}