@page "/Animal/search"
@inject NavigationManager NavigationManager
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<PageTitle>Search Animals</PageTitle>

<h3>Search for Animals!</h3>

<button class="btn btn-primary create-btn" @onclick="@(() => CreateGame())">Create New</button>
<Iroh.Components.Shared.Search currentSubject=@Page />

@code {
    Subject Page = Subject.Animal;
    private void CreateGame()
    {
        NavigationManager.NavigateTo($"/{Page.ToString()}/create");
    }
}