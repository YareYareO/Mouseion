@page "/{AppString}/create"
@using System.Diagnostics
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject IThingService ThingService
@inject NavigationManager NavigationManager
@inject ISearchThingService SearchThingService
@inject ITagService TagService
@rendermode InteractiveServer

<PageTitle>Create new Thing</PageTitle>

<form class="terminal-form">
    <fieldset>
        <legend>Create new @AppString</legend>
        <fieldset>
            <legend>Select Tags</legend>

            @* @if (tags != null && chosen != null)
            { // Display all Tags to choose from
                @for (int i = 0; i < tags.Count; i++)
                {
                    var index = i;
                    <label class="btn">
                        <input type="checkbox" @bind="chosen[index]" /> @tags[i].Name
                    </label>
                }
            } *@
            @if (tags != null && chosen != null)
            {
                var groupedTags = tags.GroupBy(tag => tag.Family)
                .OrderBy(group => group.Key); // Sortiere nach Enum-Wert der Familie

                @foreach (var group in groupedTags)
                {
                    <div role="group" aria-label="checkboxgroup" class="form-group terminal-checkbox-group">
                        <label class="checkbox-group-name">@group.Key</label>

                        @for (int i = 0; i < group.Count(); i++)
                        {
                            var tag = group.ElementAt(i);
                            var index = tags.IndexOf(tag); // Um den richtigen Index von "chosen" zu behalten

                            string btnid = "btncheck" + tag.Name;
                            <div>
                                <input type="checkbox" class="" id="@btnid" autocomplete="off" @bind="chosen[index]">
                                <label class="" for="@btnid">@tag.Name</label>
                            </div>
                        }
                    </div>
                }
            }
        </fieldset>

        <EditForm Model="CurrentThing" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit" Context="edit_context">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label for="name">Name</label>
                <InputText id="name" @bind-Value="CurrentThing.Name" class="form-control" />
                <ValidationMessage For="@(() => CurrentThing.Name)"/>
            </div>
            <div class="form-group">
                <label for="desc">Description</label>
                <InputText id="desc" @bind-Value="CurrentThing.Description" class="form-control" />
                <ValidationMessage For="@(() => CurrentThing.Description)"/>
            </div>
            <div class="form-group">
                <label for="creator">Your Nickname (Just type something. It will not be displayed.)</label>
                <InputText id="creator" @bind-Value="CurrentThing.Creator" class="form-control" />
                <ValidationMessage For="@(() => CurrentThing.Creator)"/>
            </div>
            <div class="form-group">
                <button id="submitBtn" type="submit" class="btn btn-primary">Submit</button>
            </div>
        </EditForm>
    <div id="countdown">Hallo</div>
    </fieldset>
</form>
<p>
    Rules & Guidelines:
    1. Relevance: Think to yourself "Would anybody care about this 50 years from now?"
    2. Details: Keep the description short enough to interest a reader to investigate further.
    3. Name and description can not include following characters: ', ", ;, \, &, %, #, ?, |, `, >
    4. 
</p>


<script>
(function() {
    
    const countdown = document.getElementById('countdown');
    const DELAY_SECONDS = 30;
    const initTime = Date.now();

    function secondsRemaining() {
        const elapsedMs = Date.now() - initTime;
        const remaining = Math.ceil((DELAY_SECONDS * 1000 - elapsedMs) / 1000);
        return Math.max(0, remaining);
    }
    function updateUI() {
        const rem = secondsRemaining();
        if (rem > 0) {
            countdown.textContent = 'Please wait ' + rem + ' second' + (rem !== 1 ? 's' : '') + ' before submitting.';
        } else {
            countdown.textContent = 'You are free to post!';
            clearInterval(intervalId);
        }
    }
    const intervalId = setInterval(updateUI, 1000);
    updateUI(); 
})();
</script>

@code {
    [Parameter]
    public string? AppString { get; set; }
    public Thing CurrentThing { get; set; } = new();
    private List<Tag>? tags;
    private bool[]? chosen;
    private Subject currentSubject;
    private DateTime initalTime;
    private EditContext? editContext;

    protected override async Task OnInitializedAsync()
    {
        if (AppString != null)
        {
            currentSubject = TagService.GetEnumByString(AppString);
        }

        TagFamily[] families = TagService.GetSubjectFamilies(currentSubject);
        tags = await SearchThingService.GetTagsByFamilies(families);

        chosen = new bool[tags.Count];
        initalTime = DateTime.UtcNow;
        editContext = new EditContext(CurrentThing);
        editContext.OnFieldChanged += HandleFieldChanged;
    }

    async Task HandleValidSubmit()
    {
        if((DateTime.UtcNow - initalTime) <= TimeSpan.FromSeconds(29))
        {
            Debug.WriteLine($"Submitted too early {initalTime - DateTime.UtcNow}!");
            return;
        }
        List<int> chosenTagIds = new List<int>();
        if(chosen != null && tags != null)
        {
            for (int i = 0; i < chosen.Length; i++)
            {
                if (chosen[i])
                {
                    chosenTagIds.Add(tags[i].Id);
                }
            }
        } else {
            Debug.WriteLine("What the helly!");
            return;
        }
        if(chosenTagIds.Count < 1)
        {
            Debug.WriteLine("Bro choose some Tags!");
            return;
        }
        CurrentThing.App = currentSubject;
        CurrentThing.Upvotes = 0;

        int thingId = await ThingService.CreateAsync(CurrentThing);
        await ThingService.UpdateDescriptions(chosenTagIds, thingId);
        NavigationManager.NavigateTo($"/{AppString}/search");
        return;
    }
    void HandleInvalidSubmit()
    {
        Debug.WriteLine("Input not valid!");
        return;
    }
    private void HandleFieldChanged(object sender, FieldChangedEventArgs e)
    {
        if(editContext != null)
        {
            editContext.NotifyValidationStateChanged();
        }
    }
    public void Dispose()
    {
        if (editContext != null)
            editContext.OnFieldChanged -= HandleFieldChanged;
    } 
    // TODO Check nach demselben Namen.
}
