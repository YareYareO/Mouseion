@page "/{AppString}/create"
@using System.Diagnostics
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject IThingService ThingService
@inject NavigationManager NavigationManager
@inject ISearchThingService SearchThingService
@inject ITagService TagService
@rendermode InteractiveServer

<PageTitle>Create new Thing</PageTitle>

<form class="terminal-form">
    <fieldset>
        <legend>Create new @AppString</legend>
        <fieldset>
            <legend>Select Tags</legend>
            @if (page.tags.Count > 0)
            {
                var groupedTags = page.tags.GroupBy(tag => tag.Family)
                .OrderBy(group => group.Key); // Sortiere nach Enum-Wert der Familie SORTIERE NACH JSON REIHENFOLGE TODO

                @foreach (var group in groupedTags)
                {
                    <div role="group" aria-label="checkboxgroup" class="form-group terminal-checkbox-group">
                        <label class="checkbox-group-name">@group.Key</label>

                        @for (int i = 0; i < group.Count(); i++)
                        {
                            var tag = group.ElementAt(i);
                            var index = page.tags.IndexOf(tag); // Um den richtigen Index von "chosen" zu behalten

                            string btnid = "btncheck" + tag.Name;
                            <div>
                                <input type="checkbox" class="" id="@btnid" autocomplete="off" @bind="page.chosen[index]">
                                <label class="" for="@btnid">@tag.Name</label>
                            </div>
                        }
                    </div>
                }
            }
        </fieldset>

        <EditForm OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit" EditContext=page._editContext>
            <DataAnnotationsValidator />
            <div class="form-group">
                <label for="name">Name</label>
                <InputText id="name" @bind-Value="page.CurrentThing.Name" class="form-control" />
                <ValidationMessage For="@(() => page.CurrentThing.Name)"/>
            </div>
            <div class="form-group">
                <label for="desc">Description</label>
                <InputText id="desc" @bind-Value="page.CurrentThing.Description" class="form-control" />
                <ValidationMessage For="@(() => page.CurrentThing.Description)"/>
            </div>
            <div class="form-group">
                <label for="creator">Your Nickname (Just type something. It will not be displayed.)</label>
                <InputText id="creator" @bind-Value="page.CurrentThing.Creator" class="form-control" />
                <ValidationMessage For="@(() => page.CurrentThing.Creator)"/>
            </div>
            <div class="form-group">
                <button id="submitBtn" type="submit" class="btn btn-primary">Submit</button>
            </div>
        </EditForm>
    <div id="countdown">Hallo</div>
    </fieldset>
</form>
<p>
    Rules & Guidelines:
    1. Relevance: Think to yourself "Would anybody care about this 50 years from now?"
    2. Details: Keep the description short enough to interest a reader to investigate further.
    3. Name and description can not include following characters: ', ", ;, \, &, %, #, ?, |, `, >
    4. 
</p>


<script>
(function() {
    
    const countdown = document.getElementById('countdown');
    const DELAY_SECONDS = 30;
    const initTime = Date.now();

    function secondsRemaining() {
        const elapsedMs = Date.now() - initTime;
        const remaining = Math.ceil((DELAY_SECONDS * 1000 - elapsedMs) / 1000);
        return Math.max(0, remaining);
    }
    function updateUI() {
        const rem = secondsRemaining();
        if (rem > 0) {
            countdown.textContent = 'Please wait ' + rem + ' second' + (rem !== 1 ? 's' : '') + ' before submitting.';
        } else {
            countdown.textContent = 'You are free to post!';
            clearInterval(intervalId);
        }
    }
    const intervalId = setInterval(updateUI, 1000);
    updateUI(); 
})();
</script>

@code {
    [Parameter]
    public string? AppString { get; set; }
    private CPage page { get; set; } = new();
    class CPage
    { // Exists to evade "possible" null calls
        public Thing CurrentThing { get; set;}
        public List<Tag> tags { get; set;}
        public bool[] chosen { get; set;}
        public readonly Subject currentSubject;
        public readonly DateTime initalTime;
        public EditContext _editContext { get; set;}
        public ValidationMessageStore _messageStore { get; set;}
        public CPage()
        {
            currentSubject = Subject.Any;
            CurrentThing = new Thing(currentSubject);
            _editContext = new EditContext(CurrentThing);
            _messageStore = new ValidationMessageStore(_editContext);
            initalTime = DateTime.UtcNow;
            tags = new List<Tag>(0);
            chosen = new bool[0];
        }
        public CPage(Subject sub)
        {
            currentSubject = sub;
            CurrentThing = new Thing(currentSubject);
            _editContext = new EditContext(CurrentThing);
            _messageStore = new ValidationMessageStore(_editContext);
            initalTime = DateTime.UtcNow;
            tags = new List<Tag>(0);
            chosen = new bool[0];
        }
        public void InitTags(List<Tag> ts)
        {
            this.tags = ts;
            chosen = new bool[this.tags.Count];
        }
    }
    protected override async Task OnInitializedAsync()
    {
        Subject currentSubject = Subject.Any;
        if (AppString != null) // TODO was passiert ohne appstring?
        {
            currentSubject = TagService.GetEnumByString(AppString);
        }
        TagFamily[] families = TagService.GetSubjectFamilies(currentSubject);
        List<Tag> tags = await SearchThingService.GetTagsByFamilies(families);
            
        // DO NOT add tags to constructer of CPage. if the wait is too long, the page will crash because EditContext cant initialize properly.
        page = new CPage(currentSubject); 
        page._editContext.OnFieldChanged += (s, e) => page._messageStore.Clear(e.FieldIdentifier);
        page._editContext.OnFieldChanged += HandleFieldChanged;
        page.InitTags(tags);
    }

    async Task HandleValidSubmit()
    {
        if((DateTime.UtcNow - page.initalTime) <= TimeSpan.FromSeconds(29))
        {
            Debug.WriteLine($"Submitted too early!");
            return;
        }
        List<int> chosenTagIds = new List<int>();
        
        for (int i = 0; i < page.chosen.Length; i++)
        {
            if (page.chosen[i]) chosenTagIds.Add(page.tags[i].Id);
        }
        if(chosenTagIds.Count < 1)
        {
            Debug.WriteLine("Bro choose some Tags!");
            var field = FieldIdentifier.Create(() => page.CurrentThing.Creator);
            page._messageStore.Add(field, "A post needs to have at least one fitting tag selected.");
            page._editContext.NotifyValidationStateChanged();
            return; // TODO UPDATE DATABASE
        }
        if(ThingService.DoesNameExist(page.CurrentThing.Name, page.currentSubject))
        {
            Debug.WriteLine("Name already exists!");
            var field = FieldIdentifier.Create(() => page.CurrentThing.Name);
            page._messageStore.Add(field, "A post with this name is already in use. Duplicate posts are not allowed!");
            page._editContext.NotifyValidationStateChanged();
            return;
        }
        int thingId = await ThingService.CreateAsync(page.CurrentThing);
        await ThingService.UpdateDescriptions(chosenTagIds, thingId);
        NavigationManager.NavigateTo($"/{AppString}/search");
        return;
    }
    void HandleInvalidSubmit()
    {
        Debug.WriteLine("Input not valid!");
        return;
    }
    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        page._editContext.NotifyValidationStateChanged();
    }
    public void Dispose()
    {
        page._editContext.OnFieldChanged -= (s, e) => page._messageStore.Clear(e.FieldIdentifier);
        page._editContext.OnFieldChanged -= HandleFieldChanged;
    }
}
